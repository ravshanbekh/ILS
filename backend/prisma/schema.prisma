// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum UserRole {
  admin
  teacher
  student
  filial_rahbari
  assistant
  moliya_rahbari
  kassir
  administrator
  nazoratchi
  hr_rahbari
  sotuv_operatori
  farrosh
  robototexnika_ustoz
  call_operatori
}

enum SubmissionStatus {
  pending
  checked
}

enum SubmissionResult {
  green
  blue
  red
}

// ============ MODELS ============

/// Foydalanuvchilar (Admin, O'qituvchi, O'quvchi)
model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(100)
  login        String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash")
  role         UserRole
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  teacherGroups             Group[]               @relation("TeacherGroups")
  groupStudents             GroupStudent[]
  submissions               Submission[]          @relation("StudentSubmissions")
  checkedBy                 Submission[]          @relation("CheckedByTeacher")
  notifications             Notification[]
  auditLogs                 AuditLog[]
  checklistEntries          DailyChecklistEntry[]
  frozenEntries             StudentFreeze[]       @relation("FrozenStudents")
  frozenByEntries           StudentFreeze[]       @relation("FrozenBy")
  monitoringCalls           MonitoringCall[]      @relation("MonitoringCalledBy")
  monitoringNotes           MonitoringNote[]      @relation("MonitoringNotes")
  feedbacksWritten          StudentFeedback[]     @relation("FeedbackByStudent")
  feedbacksReceived         StudentFeedback[]     @relation("FeedbackForTeacher")
  telegramLinks             TelegramLink[]        @relation("TelegramStudentLinks")
  feedbackStudent           TelegramFeedback[]    @relation("FeedbackStudent")
  feedbackTeacher           TelegramFeedback[]    @relation("FeedbackTeacher")
  // Exam relations
  createdExams              Exam[]                @relation("ExamCreator")
  examParticipations        ExamParticipant[]     @relation("ExamParticipants")
  gradedExams               ExamParticipant[]     @relation("ExamGrader")
  createdQuizzes            LiveQuiz[]            @relation("QuizCreator")
  activeQuizzes             LiveQuiz[]            @relation("ActiveQuizTeacher")
  quizResults               LiveQuizResult[]      @relation("TeacherQuizResults")
  // Lessons relations
  createdFolders            LessonFolder[]        @relation("FolderCreator")
  lessonAccess              LessonFolderAccess[]  @relation("TeacherAccess")
  // Dars baholash relations
  taughtLessonSessions      LessonSession[]       @relation("LessonSessionTeacher")
  unlockedLessonSessions    LessonSession[]       @relation("LessonSessionUnlockedBy")
  lessonGrades              LessonGrade[]         @relation("LessonGradeStudent")
  // Demo Day va Murojaatlar
  createdGroupEvents        GroupEvent[]          @relation("GroupEventCreator")
  appealsAsStudent          ParentAppeal[]        @relation("AppealStudent")
  appealsAsTeacher          ParentAppeal[]        @relation("AppealTeacher")
  appealsReplied            ParentAppeal[]        @relation("AppealRepliedBy")
  eventFeedbacksAsStudent   EventFeedback[]       @relation("EventFeedbackStudent")
  eventFeedbacksAsTeacher   EventFeedback[]       @relation("EventFeedbackTeacher")
  // Gamifikatsiya — coin va do'kon
  coinTransactionsAsStudent CoinTransaction[]     @relation("CoinTransactionStudent")
  coinTransactionsAsTeacher CoinTransaction[]     @relation("CoinTransactionTeacher")
  shopOrdersAsStudent       ShopOrder[]           @relation("ShopOrderStudent")
  shopOrdersFulfilled       ShopOrder[]           @relation("ShopOrderFulfilledBy")
  // Qo'lda beriladigan ruxsatlar
  permissions               UserPermission[]      @relation("UserPermissions")
  permissionsGranted        UserPermission[]      @relation("PermissionGrantedBy")

  @@map("users")
}

/// Guruhlar
model Group {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(50)
  teacherId String?  @map("teacher_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Dars kuni (jadval o'rniga — soatsiz, faqat juft/toq/har kuni)
  lessonDayType LessonDayType? @map("lesson_day_type")

  // Telegram guruh chati (ota-onalar uchun 20:00 yig'ma xabar)
  telegramChatId        BigInt?   @map("telegram_chat_id")
  telegramChatTitle     String?   @map("telegram_chat_title") @db.VarChar(200)
  chatLinkCode          String?   @map("chat_link_code") @db.VarChar(10)
  chatLinkCodeExpiresAt DateTime? @map("chat_link_code_expires_at")

  // Relations
  teacher          User?             @relation("TeacherGroups", fields: [teacherId], references: [id])
  groupStudents    GroupStudent[]
  groupNormatives  GroupNormative[]
  submissions      Submission[]
  rankingCache     RankingCache[]
  monitoringCalls  MonitoringCall[]
  feedbacks        StudentFeedback[]
  liveQuizzes      LiveQuiz[]
  examParticipants ExamParticipant[]
  lessonSessions   LessonSession[]
  events           GroupEvent[]
  appeals          ParentAppeal[]
  eventFeedbacks   EventFeedback[]

  @@map("groups")
}

/// Kategoriyalar (Yo'nalishlar: Foundation, Frontend, Backend)
model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  normatives Normative[]
  exams      Exam[]
  quizzes    LiveQuiz[]

  @@map("categories")
}

/// Guruh-O'quvchi bog'liqlik
model GroupStudent {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Relations
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@map("group_students")
}

/// Normativlar (Funksiya/Vazifalar)
model Normative {
  id          String   @id @default(uuid()) @db.Uuid
  taskNumber  Int      @map("task_number")
  title       String
  description String?
  timeLimit   Int?     @map("time_limit")
  url         String?
  maxScore    Int      @default(40) @map("max_score")
  isActive    Boolean  @default(true) @map("is_active")
  categoryId  String?  @map("category_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  category        Category?        @relation(fields: [categoryId], references: [id])
  groupNormatives GroupNormative[]
  submissions     Submission[]

  @@map("normatives")
}

/// Guruh-Normativ bog'liqlik
model GroupNormative {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  normativeId String   @map("normative_id") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at")

  // Relations
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  normative Normative @relation(fields: [normativeId], references: [id], onDelete: Cascade)

  @@unique([groupId, normativeId])
  @@map("group_normatives")
}

/// O'quvchi Topshiriqlari (Submissions)
model Submission {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  normativeId String           @map("normative_id") @db.Uuid
  groupId     String?          @map("group_id") @db.Uuid
  youtubeUrl  String           @map("youtube_url")
  submittedAt DateTime         @default(now()) @map("submitted_at")
  status      SubmissionStatus @default(pending)
  canResubmit Boolean          @default(false) @map("can_resubmit")

  // O'qituvchi tekshirgandan so'ng
  checkedById String?           @map("checked_by") @db.Uuid
  checkedAt   DateTime?         @map("checked_at")
  result      SubmissionResult?
  score       Int               @default(0)
  comment     String?

  // Relations
  student   User      @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  normative Normative @relation(fields: [normativeId], references: [id], onDelete: Cascade)
  group     Group?    @relation(fields: [groupId], references: [id])
  checkedBy User?     @relation("CheckedByTeacher", fields: [checkedById], references: [id])

  @@unique([studentId, normativeId])
  @@map("submissions")
}

/// Reyting Cache (kunlik hisoblash)
model RankingCache {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  groupId     String?  @map("group_id") @db.Uuid
  totalScore  Int      @default(0) @map("total_score")
  completed   Int      @default(0)
  pending     Int      @default(0)
  rankInGroup Int?     @map("rank_in_group")
  rankOverall Int?     @map("rank_overall")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  group Group? @relation(fields: [groupId], references: [id])

  @@map("ranking_cache")
}

/// Audit Log (kim nima qildi)
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetId   String?  @map("target_id") @db.Uuid
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

/// Xabarnomalar
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50)
  title     String
  body      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// Kunlik Checklist elementlari (template)
model ChecklistItem {
  id          String   @id @default(uuid()) @db.Uuid
  role        UserRole
  order       Int
  score       Int      @default(1)
  section     String?  @db.VarChar(200)
  category    String   @db.VarChar(200)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  entries DailyChecklistEntry[]

  @@map("checklist_items")
}

/// Kunlik Checklist yozuvlari (kim, qachon, bajarildimi)
model DailyChecklistEntry {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  checklistItemId String    @map("checklist_item_id") @db.Uuid
  date            DateTime  @db.Date
  isDone          Boolean   @default(false) @map("is_done")
  doneAt          DateTime? @map("done_at")

  // Relations
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([userId, checklistItemId, date])
  @@map("daily_checklist_entries")
}

// ============ FREEZE SYSTEM ============

enum FreezeReason {
  moliyaviy // Moliyaviy (to'lov)
  kochib_ketish // Ko'chib/safarga ketish
  vaqtincha_toxtatgan // Vaqtincha to'xtatgan (qaytish rejasi bor)
  kasallik // Kasallik
  kanikul // Lager/Kanikul (vaqtinchalik)
  boshqa_fan // Boshqa fan/sertifikatga o'tish
  kurs_tugadi // Kurs tugadi, davomi yo'q
  motivatsiya // Motivatsiya/oilaviy sabab
  ish_tadbir // Ishga ketish/oilaviy tadbir
  universitet // Universitet sessiyasi
  shaxsiy // Shaxsiy sabab
  oqituvchidan_norozi // O'qituvchidan norozilik
  boshqa // Boshqa
  sabab_korsatilmagan // Sabab ko'rsatilmagan
}

/// Muzlatilgan O'quvchilar (Ketish Hisoboti)
model StudentFreeze {
  id           String       @id @default(uuid()) @db.Uuid
  studentId    String       @map("student_id") @db.Uuid
  frozenById   String       @map("frozen_by_id") @db.Uuid
  frozenAt     DateTime     @default(now()) @map("frozen_at")
  month        Int // Muzlatilgan oy (1-12)
  year         Int // Muzlatilgan yil (2025, 2026...)
  reason       FreezeReason // Sabab kategoriyasi
  detailedNote String?      @map("detailed_note") @db.VarChar(1000)
  phone        String?      @db.VarChar(30)
  startDate    DateTime?    @map("start_date") // Kursga kirgan sana
  filial       String?      @db.VarChar(100) // Filial (Beeline, Stomatologiya...)

  // Muzlatish vaqtidagi snapshot (o'zgarmas qoladi)
  studentName String  @map("student_name") @db.VarChar(200)
  teacherName String? @map("teacher_name") @db.VarChar(200)
  groupName   String? @map("group_name") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  student  User @relation("FrozenStudents", fields: [studentId], references: [id])
  frozenBy User @relation("FrozenBy", fields: [frozenById], references: [id])

  @@map("student_freezes")
}

// ============ MONITORING SYSTEM ============

enum MonitoringMood {
  yaxshi // 😊 Hamma narsa yaxshi
  oddiy // 😐 Alohida shikoyat yo'q
  yomon // 😟 Muammo bor, norozilik
  javob_bermadi // 📵 Telefonga javob bermadi
}

/// Monitoring qo'ng'iroq sessiyasi (administrator qaysi guruhga qo'ng'iroq qildi)
model MonitoringCall {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  calledById String   @map("called_by_id") @db.Uuid
  callDate   DateTime @default(now()) @map("call_date")
  summary    String?  @db.VarChar(500) // Umumiy qisqa izoh
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  group    Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  calledBy User             @relation("MonitoringCalledBy", fields: [calledById], references: [id])
  notes    MonitoringNote[]

  @@map("monitoring_calls")
}

/// Har bir o'quvchi uchun monitoring fikri
model MonitoringNote {
  id        String         @id @default(uuid()) @db.Uuid
  callId    String         @map("call_id") @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  mood      MonitoringMood
  note      String         @db.VarChar(2000)
  tags      String[]       @default([])
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relations
  call    MonitoringCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  student User           @relation("MonitoringNotes", fields: [studentId], references: [id])

  @@map("monitoring_notes")
}

// ============ TELEGRAM BOT SYSTEM ============

/// Telegram Chat bog'lanishi (Ota-ona/Operator → O'quvchi)
model TelegramLink {
  id               String   @id @default(uuid()) @db.Uuid
  telegramId       BigInt   @map("telegram_id") // Telegram user ID — bitta ota-ona bir nechta farzandga ulanishi uchun endi yakka o'zi unique emas
  chatId           BigInt   @map("chat_id") // Telegram chat ID
  studentId        String   @map("student_id") @db.Uuid // Bog'langan o'quvchi
  role             String   @default("parent") @db.VarChar(20) // "parent" | "admin"
  fullName         String?  @map("full_name") @db.VarChar(200)
  username         String?  @db.VarChar(100) // @username
  isActive         Boolean  @default(true) @map("is_active")
  language         String   @default("uz") @db.VarChar(5) // "uz" | "ru"
  notifyOnCheck    Boolean  @default(true) @map("notify_on_check")
  notifyOnRank     Boolean  @default(true) @map("notify_on_rank")
  notifyWeekly     Boolean  @default(true) @map("notify_weekly")
  notifyInactivity Boolean  @default(true) @map("notify_inactivity")
  lastActiveAt     DateTime @default(now()) @map("last_active_at") // Botda oxirgi marta "faol farzand" sifatida tanlangan payt
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  student        User            @relation("TelegramStudentLinks", fields: [studentId], references: [id])
  eventRsvps     EventRsvp[]
  appeals        ParentAppeal[]
  eventFeedbacks EventFeedback[]

  @@unique([telegramId, studentId])
  @@map("telegram_links")
}

/// Telegram orqali yuborilgan feedback (ota-ona → o'qituvchi)
model TelegramFeedback {
  id         String    @id @default(uuid()) @db.Uuid
  telegramId BigInt    @map("telegram_id")
  studentId  String    @map("student_id") @db.Uuid
  teacherId  String?   @map("teacher_id") @db.Uuid
  message    String    @db.VarChar(2000)
  isRead     Boolean   @default(false) @map("is_read")
  repliedAt  DateTime? @map("replied_at")
  replyText  String?   @map("reply_text") @db.VarChar(2000)
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  student User  @relation("FeedbackStudent", fields: [studentId], references: [id])
  teacher User? @relation("FeedbackTeacher", fields: [teacherId], references: [id])

  @@map("telegram_feedbacks")
}

/// AI tomonidan yaratilgan tahlil hisobotlari (cache)
model MonitoringAIReport {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String?  @map("group_id") @db.Uuid
  teacherId  String?  @map("teacher_id") @db.Uuid
  reportType String   @db.VarChar(50) // "group_analysis" | "teacher_analysis" | "overall"
  content    String // AI javob matni (plain text)
  period     String   @db.VarChar(20) // "2026-06"
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("monitoring_ai_reports")
}

/// Student feedback for teacher
model StudentFeedback {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  teacherId   String   @map("teacher_id") @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  rating      Int // 1-5
  comment     String?  @db.VarChar(500)
  isAnonymous Boolean  @default(true) @map("is_anonymous")
  createdAt   DateTime @default(now()) @map("created_at")

  student User  @relation("FeedbackByStudent", fields: [studentId], references: [id])
  teacher User  @relation("FeedbackForTeacher", fields: [teacherId], references: [id])
  group   Group @relation(fields: [groupId], references: [id])

  @@map("student_feedbacks")
}

// ============================================================
//  EXAM SYSTEM (3-bosqichli rasmiy imtihon)
// ============================================================

enum ExamStatus {
  draft
  active
  completed
  cancelled
}

enum ExamParticipantStatus {
  joined
  in_progress
  submitted
  timeout
}

/// Rasmiy imtihon
model Exam {
  id            String     @id @default(uuid()) @db.Uuid
  title         String     @db.VarChar(200)
  description   String?    @db.VarChar(500)
  categoryId    String?    @map("category_id") @db.Uuid
  createdById   String     @map("created_by_id") @db.Uuid
  accessCode    String     @unique @map("access_code") @db.VarChar(20)
  startsAt      DateTime   @map("starts_at")
  expiresAt     DateTime   @map("expires_at")
  status        ExamStatus @default(draft)
  testCount     Int        @default(20) @map("test_count")
  durationHours Int        @default(2) @map("duration_hours")
  isGlobal      Boolean    @default(false) @map("is_global")
  templateId    String?    @map("template_id") @db.Uuid

  // Maksimal ballar
  maxTestScore    Int @default(40) @map("max_test_score")
  maxAiScore      Int @default(20) @map("max_ai_score")
  maxProjectScore Int @default(40) @map("max_project_score")

  // Dinamik bosqich nomlari
  step2Name String @default("AI video taqdimot") @map("step2_name") @db.VarChar(100)
  step3Name String @default("Loyiha (Youtube link)") @map("step3_name") @db.VarChar(100)

  // Dinamik bosqich turlari: link | code | text
  step2Type String @default("link") @map("step2_type") @db.VarChar(20)
  step3Type String @default("link") @map("step3_type") @db.VarChar(20)

  // Bosqich tavsiflari (qoidalar, ko'rsatmalar)
  step2Desc String @default("") @map("step2_desc") @db.VarChar(500)
  step3Desc String @default("") @map("step3_desc") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  category     Category?         @relation(fields: [categoryId], references: [id])
  createdBy    User              @relation("ExamCreator", fields: [createdById], references: [id])
  template     Exam?             @relation("ExamTemplate", fields: [templateId], references: [id])
  sessions     Exam[]            @relation("ExamTemplate")
  questions    ExamQuestion[]
  participants ExamParticipant[]

  @@map("exams")
}

/// Imtihon savollari
model ExamQuestion {
  id       String  @id @default(uuid()) @db.Uuid
  examId   String  @map("exam_id") @db.Uuid
  question String
  imageUrl String? @map("image_url")
  options  Json // ["variant A", "variant B", "variant C", "variant D"]
  correct  Int // 0-3 (to'g'ri javob indeksi)
  order    Int     @default(0)

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@map("exam_questions")
}

/// Imtihon ishtirokchisi (urinishlar tarixi bilan)
model ExamParticipant {
  id            String                @id @default(uuid()) @db.Uuid
  examId        String                @map("exam_id") @db.Uuid
  studentId     String                @map("student_id") @db.Uuid
  groupId       String?               @map("group_id") @db.Uuid
  teacherId     String?               @map("teacher_id") @db.Uuid
  attemptNumber Int                   @default(1) @map("attempt_number")
  status        ExamParticipantStatus @default(joined)
  startedAt     DateTime?             @map("started_at")
  submittedAt   DateTime?             @map("submitted_at")

  // Test natijalari
  testScore    Int? @map("test_score")
  correctCount Int? @map("correct_count")

  // Video havolalar (link turi uchun)
  aiVideoUrl      String? @map("ai_video_url")
  projectVideoUrl String? @map("project_video_url")

  // Matn/kod topshirishlar (code | text turi uchun)
  step2Content String? @map("step2_content") @db.Text
  step3Content String? @map("step3_content") @db.Text

  // O'qituvchi tomonidan baho
  aiScore        Int?      @map("ai_score")
  projectScore   Int?      @map("project_score")
  totalScore     Int?      @map("total_score")
  aiComment      String?   @map("ai_comment") @db.VarChar(1000)
  projectComment String?   @map("project_comment") @db.VarChar(1000)
  gradedById     String?   @map("graded_by_id") @db.Uuid
  gradedAt       DateTime? @map("graded_at")

  createdAt DateTime @default(now()) @map("created_at")

  exam     Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  student  User         @relation("ExamParticipants", fields: [studentId], references: [id])
  gradedBy User?        @relation("ExamGrader", fields: [gradedById], references: [id])
  group    Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  answers  ExamAnswer[]

  @@unique([examId, studentId, attemptNumber])
  @@map("exam_participants")
}

/// Imtihon javoblari (test bosqichi)
model ExamAnswer {
  id             String   @id @default(uuid()) @db.Uuid
  participantId  String   @map("participant_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  selectedOption Int      @map("selected_option")
  isCorrect      Boolean  @map("is_correct")
  answeredAt     DateTime @default(now()) @map("answered_at")

  participant ExamParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question    ExamQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionId])
  @@map("exam_answers")
}

// ============================================================
//  LIVE QUIZ SYSTEM (Kahoot/Wayground uslubi)
// ============================================================

enum QuizStatus {
  waiting
  active
  finished
}

/// Real-time interaktiv quiz musiqalari
model QuizMusic {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(150)
  url       String // music file path / url
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  liveQuizzes LiveQuiz[]

  @@map("quiz_musics")
}

/// Real-time interaktiv quiz
model LiveQuiz {
  id                String     @id @default(uuid()) @db.Uuid
  title             String     @db.VarChar(200)
  description       String?    @db.VarChar(500)
  code              String     @unique @db.VarChar(10)
  createdById       String     @map("created_by_id") @db.Uuid
  status            QuizStatus @default(waiting)
  currentQ          Int        @default(-1) @map("current_q") // -1 = hali boshlanmagan
  timePerQ          Int        @default(20) @map("time_per_q") // soniyada
  isGlobal          Boolean    @default(false) @map("is_global") // Admin tomonidan yaratilgan markaz quizlari
  activeQuestionIds Json?      @map("active_question_ids") // Random tanlangan 20 ta savol IDlari
  musicId           String?    @map("music_id") @db.Uuid
  categoryId        String?    @map("category_id") @db.Uuid
  activeTeacherId   String?    @map("active_teacher_id") @db.Uuid
  groupId           String?    @map("group_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")

  createdBy     User               @relation("QuizCreator", fields: [createdById], references: [id])
  activeTeacher User?              @relation("ActiveQuizTeacher", fields: [activeTeacherId], references: [id])
  group         Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  category      Category?          @relation(fields: [categoryId], references: [id])
  music         QuizMusic?         @relation(fields: [musicId], references: [id])
  questions     LiveQuizQuestion[]
  players       LiveQuizPlayer[]
  results       LiveQuizResult[]

  @@map("live_quizzes")
}

/// O'tkazilgan live quiz natijasi (oqituvchi va guruh bo'yicha eng oxirgi natija)
model LiveQuizResult {
  id           String   @id @default(uuid()) @db.Uuid
  quizId       String   @map("quiz_id") @db.Uuid
  groupId      String   @default("") @map("group_id")
  teacherId    String   @map("teacher_id") @db.Uuid
  quizTitle    String   @map("quiz_title")
  leaderboard  Json // [{ fullName, score, rank, streak }]
  totalPlayers Int      @default(0) @map("total_players")
  updatedAt    DateTime @updatedAt @map("updated_at")

  teacher User     @relation("TeacherQuizResults", fields: [teacherId], references: [id], onDelete: Cascade)
  quiz    LiveQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, groupId, teacherId])
  @@map("live_quiz_results")
}

/// Live quiz savoli
model LiveQuizQuestion {
  id       String  @id @default(uuid()) @db.Uuid
  quizId   String  @map("quiz_id") @db.Uuid
  question String
  options  Json // ["A","B","C","D"]
  correct  Int
  order    Int     @default(0)
  imageUrl String? @map("image_url")

  quiz    LiveQuiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers LiveQuizAnswer[]

  @@map("live_quiz_questions")
}

/// Live quiz o'yinchisi (tizimdan tashqari, faqat ism bilan)
model LiveQuizPlayer {
  id       String   @id @default(uuid()) @db.Uuid
  quizId   String   @map("quiz_id") @db.Uuid
  fullName String   @map("full_name") @db.VarChar(100)
  score    Int      @default(0)
  streak   Int      @default(0)
  rank     Int?
  joinedAt DateTime @default(now()) @map("joined_at")

  quiz    LiveQuiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers LiveQuizAnswer[]

  @@map("live_quiz_players")
}

/// Live quiz javob
model LiveQuizAnswer {
  id         String  @id @default(uuid()) @db.Uuid
  playerId   String  @map("player_id") @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  selected   Int
  isCorrect  Boolean @map("is_correct")
  timeMs     Int     @map("time_ms") // Javob tezligi (ms)
  points     Int     @default(0)

  player   LiveQuizPlayer   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  question LiveQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([playerId, questionId])
  @@map("live_quiz_answers")
}

// ============================================================
//  DARSLIKLAR (Lesson Folders & Items)
// ============================================================

/// Darslik papkasi (Foundation, Frontend, Backend...) — ichma-ich (nested) bo'lishi mumkin
model LessonFolder {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  icon        String   @default("📁") @db.VarChar(10)
  order       Int      @default(0)
  parentId    String?  @map("parent_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User                 @relation("FolderCreator", fields: [createdById], references: [id])
  parent    LessonFolder?        @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  LessonFolder[]       @relation("FolderChildren")
  items     LessonItem[]
  access    LessonFolderAccess[]

  @@map("lesson_folders")
}

/// Darslik (Canva / PPTX / Video link)
model LessonItem {
  id        String   @id @default(uuid()) @db.Uuid
  folderId  String   @map("folder_id") @db.Uuid
  title     String   @db.VarChar(200)
  url       String
  type      String   @default("link") @db.VarChar(20)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  folder LessonFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@map("lesson_items")
}

/// Papkaga o'qituvchi ruxsati
model LessonFolderAccess {
  id        String   @id @default(uuid()) @db.Uuid
  folderId  String   @map("folder_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  folder  LessonFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  teacher User         @relation("TeacherAccess", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([folderId, teacherId])
  @@map("lesson_folder_access")
}

// ============================================================
//  DARS BAHOLASH TIZIMI (Lesson Session / Grade)
// ============================================================

/// Guruhning dars kunlari — jadval o'rniga soatsiz belgi
enum LessonDayType {
  juft // Oyning juft kunlari
  toq // Oyning toq kunlari
  har_kuni // Har kuni dars bo'ladi
}

enum LessonSessionStatus {
  ochiq // O'qituvchi boshladi, baholash davom etmoqda
  yakunlandi // O'qituvchi "Yakunlash" bosdi
  avto_yopildi // 2 soat o'tib, yakunlanmagani uchun tizim yopdi
}

enum HomeworkGrade {
  toliq // 5 ball
  qisman // 3 ball
  bajarmagan // 0 ball
  kelmadi // Darsga kelmadi — o'rtachaga kirmaydi
}

/// Bitta guruhning bitta kundagi dars sessiyasi (baholash oynasi)
model LessonSession {
  id        String              @id @default(uuid()) @db.Uuid
  groupId   String              @map("group_id") @db.Uuid
  teacherId String              @map("teacher_id") @db.Uuid
  date      DateTime            @db.Date
  status    LessonSessionStatus @default(ochiq)
  topic     String?             @db.VarChar(300)

  startedAt        DateTime  @default(now()) @map("started_at")
  deadlineAt       DateTime  @map("deadline_at") // startedAt + 120 daqiqa
  homeworkGradedAt DateTime? @map("homework_graded_at") // barcha o'quvchi uy vazifasi bo'yicha baholangan payt
  finalizedAt      DateTime? @map("finalized_at") // "Yakunlash" bosilgan payt
  parentNotifyAt   DateTime? @map("parent_notify_at") // finalizedAt + 1 soat
  parentNotifiedAt DateTime? @map("parent_notified_at")

  // Admin (Ravshan) tomonidan qayta ochilgan bo'lsa
  unlockedById String?   @map("unlocked_by_id") @db.Uuid
  unlockedAt   DateTime? @map("unlocked_at")
  unlockNote   String?   @map("unlock_note") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher          User              @relation("LessonSessionTeacher", fields: [teacherId], references: [id])
  unlockedBy       User?             @relation("LessonSessionUnlockedBy", fields: [unlockedById], references: [id])
  grades           LessonGrade[]
  coinTransactions CoinTransaction[]

  @@unique([groupId, date])
  @@map("lesson_sessions")
}

/// O'quvchining bitta darsdagi bahosi (uy vazifasi 5/3/0 + faollik 1-5)
model LessonGrade {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  homework      HomeworkGrade?
  homeworkScore Int?           @map("homework_score") // 5 | 3 | 0 | null (kelmadi)
  activityScore Int?           @map("activity_score") // 1..5
  autoZero      Boolean        @default(false) @map("auto_zero") // vaqt tugab, o'qituvchi ulgurmagani uchun avtomatik 0

  coinAwarded   Int?      @map("coin_awarded") // shu darsda berilgan gamifikatsiya coini
  coinAwardedAt DateTime? @map("coin_awarded_at")

  comment          String?   @db.VarChar(500)
  gradedAt         DateTime? @map("graded_at") // uy vazifasi baholangan payt
  activityGradedAt DateTime? @map("activity_graded_at")

  // Relations
  session LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User          @relation("LessonGradeStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@map("lesson_grades")
}

// ============================================================
//  DEMO DAY (tadbir + RSVP)
// ============================================================

model GroupEvent {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  title       String   @db.VarChar(200)
  eventAt     DateTime @map("event_at")
  place       String?  @db.VarChar(300)
  description String?  @db.VarChar(1000)
  createdById String   @map("created_by_id") @db.Uuid

  invitedAt           DateTime? @map("invited_at")
  reminder7dAt        DateTime? @map("reminder_7d_at")
  reminder1dAt        DateTime? @map("reminder_1d_at")
  reminder2hAt        DateTime? @map("reminder_2h_at")
  feedbackRequestedAt DateTime? @map("feedback_requested_at")

  createdAt DateTime @default(now()) @map("created_at")

  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User            @relation("GroupEventCreator", fields: [createdById], references: [id])
  rsvps     EventRsvp[]
  feedbacks EventFeedback[]

  @@map("group_events")
}

enum RsvpAnswer {
  boraman
  yoq
  aniq_emas
}

model EventRsvp {
  id             String     @id @default(uuid()) @db.Uuid
  eventId        String     @map("event_id") @db.Uuid
  telegramLinkId String     @map("telegram_link_id") @db.Uuid
  answer         RsvpAnswer
  respondedAt    DateTime   @default(now()) @map("responded_at")

  event        GroupEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  telegramLink TelegramLink @relation(fields: [telegramLinkId], references: [id], onDelete: Cascade)

  @@unique([eventId, telegramLinkId])
  @@map("event_rsvps")
}

// ============================================================
//  MUROJAATLAR (Ota-ona shikoyat/taklif/e'tiroz/minnatdorchilik)
// ============================================================

enum AppealType {
  shikoyat
  taklif
  etiroz
  minnatdorchilik
}

enum AppealStatus {
  yangi
  korib_chiqilmoqda
  hal_qilindi
}

model ParentAppeal {
  id             String  @id @default(uuid()) @db.Uuid
  telegramLinkId String  @map("telegram_link_id") @db.Uuid
  studentId      String  @map("student_id") @db.Uuid
  groupId        String? @map("group_id") @db.Uuid
  teacherId      String? @map("teacher_id") @db.Uuid

  type    AppealType
  message String     @db.VarChar(2000)

  aiReply    String? @map("ai_reply") @db.Text
  aiCategory String? @map("ai_category") @db.VarChar(50)
  aiUrgency  Int?    @map("ai_urgency") // 1-5

  status      AppealStatus @default(yangi)
  adminReply  String?      @map("admin_reply") @db.VarChar(2000)
  repliedAt   DateTime?    @map("replied_at")
  repliedById String?      @map("replied_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  telegramLink TelegramLink @relation(fields: [telegramLinkId], references: [id], onDelete: Cascade)
  student      User         @relation("AppealStudent", fields: [studentId], references: [id])
  teacher      User?        @relation("AppealTeacher", fields: [teacherId], references: [id])
  group        Group?       @relation(fields: [groupId], references: [id])
  repliedBy    User?        @relation("AppealRepliedBy", fields: [repliedById], references: [id])

  @@map("parent_appeals")
}

// ============================================================
//  DEMO DAY FIKR-MULOHAZASI (Tadbirdan keyingi ota-ona feedback)
// ============================================================

enum EventFeedbackSatisfaction {
  mamnun // 😊 Ko'ngli to'ldi
  oddiy // 😐 Oddiy
  norozi // 😞 Yoqmadi
}

model EventFeedback {
  id             String  @id @default(uuid()) @db.Uuid
  eventId        String  @map("event_id") @db.Uuid
  telegramLinkId String  @map("telegram_link_id") @db.Uuid
  studentId      String  @map("student_id") @db.Uuid
  groupId        String  @map("group_id") @db.Uuid // snapshot — filtrlash tez bo'lishi uchun
  teacherId      String? @map("teacher_id") @db.Uuid // snapshot

  satisfaction EventFeedbackSatisfaction
  comment      String?                   @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at")

  event        GroupEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  telegramLink TelegramLink @relation(fields: [telegramLinkId], references: [id], onDelete: Cascade)
  student      User         @relation("EventFeedbackStudent", fields: [studentId], references: [id])
  teacher      User?        @relation("EventFeedbackTeacher", fields: [teacherId], references: [id])
  group        Group        @relation(fields: [groupId], references: [id])

  @@unique([eventId, telegramLinkId])
  @@map("event_feedbacks")
}

// ============================================================
//  QO'LDA BERILADIGAN RUXSATLAR (rol ustiga qo'shimcha)
// ============================================================

/// Foydalanuvchiga admin tomonidan qo'lda berilgan bitta ruxsat.
/// Yozuv bor = ruxsat bor, yozuv yo'q = ruxsat yo'q. Admin roli har doim
/// to'liq huquqli (uning uchun bu jadval tekshirilmaydi).
model UserPermission {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  permission  String   @db.VarChar(64) // shared/constants/permissions.ts dagi kalit
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  user      User  @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("PermissionGrantedBy", fields: [grantedById], references: [id])

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permissions")
}

// ============================================================
//  GAMIFIKATSIYA — COIN TIZIMI VA DO'KON
// ============================================================

/// Coin harakati — o'qituvchi bergan (musbat) yoki do'kondan sarflangan/qaytarilgan (manfiy/musbat) har bir yozuv.
/// O'quvchining joriy balansi shu jadvaldagi barcha amount'lar yig'indisi sifatida hisoblanadi (keshlanmaydi).
model CoinTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  teacherId       String?  @map("teacher_id") @db.Uuid // kim berdi — do'kon xarid/qaytarishda null
  amount          Int // musbat = berildi, manfiy = sarflandi
  reason          String?  @db.VarChar(300)
  lessonSessionId String?  @map("lesson_session_id") @db.Uuid // ixtiyoriy — qaysi dars orqali berilgani
  shopOrderId     String?  @map("shop_order_id") @db.Uuid // ixtiyoriy — do'kon xaridi/qaytarish bo'lsa
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  student       User           @relation("CoinTransactionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher       User?          @relation("CoinTransactionTeacher", fields: [teacherId], references: [id])
  lessonSession LessonSession? @relation(fields: [lessonSessionId], references: [id], onDelete: SetNull)
  shopOrder     ShopOrder?     @relation(fields: [shopOrderId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([teacherId, createdAt])
  @@map("coin_transactions")
}

/// Do'kon tovari/sovg'asi (admin kiritadi)
model ShopItem {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(1000)
  price       Int // necha coin turadi
  imageUrl    String?  @map("image_url")
  stock       Int? // ixtiyoriy — cheklangan miqdor (null = cheksiz)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  orders ShopOrder[]

  @@map("shop_items")
}

enum ShopOrderStatus {
  kutilmoqda
  berildi
  bekor_qilindi
}

/// O'quvchining do'kondan sovg'a so'rovi (zayavka)
model ShopOrder {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid

  priceAtOrder Int             @map("price_at_order") // buyurtma paytidagi narx (tarixiy)
  status       ShopOrderStatus @default(kutilmoqda)

  fulfilledById String?   @map("fulfilled_by_id") @db.Uuid // kassir/admin kim berdi
  fulfilledAt   DateTime? @map("fulfilled_at")
  cancelNote    String?   @map("cancel_note") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  student          User              @relation("ShopOrderStudent", fields: [studentId], references: [id], onDelete: Cascade)
  item             ShopItem          @relation(fields: [itemId], references: [id])
  fulfilledBy      User?             @relation("ShopOrderFulfilledBy", fields: [fulfilledById], references: [id])
  coinTransactions CoinTransaction[]

  @@map("shop_orders")
}
